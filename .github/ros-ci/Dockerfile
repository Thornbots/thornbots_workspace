# Portable ROS CI image: Jazzy, every external rosdep key of the portable
# packages (deps/package.xml, generated by ros_ci.py), ccache and the hosted
# MCB firmware toolchain. Its tag hashes this file and deps/package.xml; bump
# REFRESH to pick up newer apt packages without an input change.
FROM ros:jazzy-ros-base-noble@sha256:5147d3ae250ce754afd399f6bfec15b33dd4e473ca357e30432a3182031bfad6

ARG REFRESH=2026-11-23
ARG DEBIAN_FRONTEND=noninteractive
COPY deps/package.xml /tmp/ros-ci-deps/package.xml
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential ccache g++-14 gcc-14 python3-colcon-common-extensions python3-venv \
 && rosdep update --rosdistro jazzy \
 && rosdep install --from-paths /tmp/ros-ci-deps --rosdistro jazzy -y \
 && python3 -m venv /opt/mcb-tools \
 && /opt/mcb-tools/bin/pip install --no-cache-dir scons==4.11.1 pyelftools==0.32 Jinja2==3.1.6 \
 && apt-get clean && rm -rf /var/lib/apt/lists/* /root/.ros/rosdep /tmp/ros-ci-deps
